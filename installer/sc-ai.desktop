# SC.AI desktop entry (template).
#
# install.sh substitutes @EXEC@ and @ICON@ with the real, user-local install
# paths so the final file never references a development directory.
#
# NOTE: do not edit this file directly after installation; the installed copy
# lives at ~/.local/share/applications/sc-ai.desktop.

[Desktop Entry]
Type=Application
Version=1.0
Name=SC.AI
GenericName=AI Chat
Comment=SC.AI Agentic Browser — AI chat with a dedicated browser profile
Exec=@EXEC@
Icon=@ICON@
Terminal=false
Categories=Network;Utility;
Keywords=AI;chat;browser;NVIDIA;selenium
StartupNotify=true
StartupWMClass=sc-ai